{
  "expo": {
    "name": "Pickolo Customer",
    "slug": "pickolo-customer",
    "scheme": "pickolo-customer",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp"
        ]
      }
    },
    "android": {
      "package": "com.smfstudios.pickolocustomer",
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      [
        "expo-router"
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pickolo uses your location to help find a nearby photographer."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ]
  }
}
