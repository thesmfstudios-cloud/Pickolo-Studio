{
  "expo": {
    "name": "Pickolo",
    "slug": "pickolo-customer",
    "scheme": "pickolo-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["tez", "phonepe", "paytmmp"]
      }
    },
    "android": {
      "package": "com.smfstudios.pickolocustomer",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#153f2e"
      }
    },
    "plugins": [
      ["expo-router"],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pickolo uses your location to help find a nearby photographer."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#faf7ef",
          "imageWidth": 120,
          "image": "./assets/icon.png"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
