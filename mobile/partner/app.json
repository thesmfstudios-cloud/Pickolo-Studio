{
  "expo": {
    "name": "Pickolo Partner",
    "slug": "pickolo-partner",
    "scheme": "pickolo-partner",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.smfstudios.pickolopartner",
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      [
        "expo-router"
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pickolo uses your location to match nearby photography assignments."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ]
  }
}
